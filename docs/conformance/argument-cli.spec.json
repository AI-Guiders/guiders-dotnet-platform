{
  "version": 1,
  "surface": "argument-cli",
  "source": "GUIDERS-ADR-0021 POSIX/System.CommandLine-aligned CLI quarry",
  "vectors": [
    {
      "id": "help-flag",
      "tail": "-h",
      "expect": {
        "readerId": "cli",
        "slots": { "-h": "true" }
      }
    },
    {
      "id": "long-equals",
      "tail": "--out=release",
      "expect": {
        "readerId": "cli",
        "slots": { "--out": "release" }
      }
    },
    {
      "id": "config-equals",
      "tail": "--config=release",
      "expect": {
        "readerId": "cli",
        "slots": { "--config": "release" }
      }
    },
    {
      "id": "clustered-shorts",
      "tail": "-abc",
      "expect": {
        "readerId": "cli",
        "slots": { "-a": "true", "-b": "true", "-c": "true" }
      }
    },
    {
      "id": "mixed-tail",
      "tail": "-h --verbose file.txt",
      "expect": {
        "readerId": "cli",
        "slots": { "-h": "true", "--verbose": "true", "@2": "file.txt" }
      }
    }
  ]
}
