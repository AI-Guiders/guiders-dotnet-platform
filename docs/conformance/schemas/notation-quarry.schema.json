{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiders.dev/conformance/schemas/notation-quarry.schema.json",
  "title": "Keyboard quarry conformance spec",
  "type": "object",
  "required": ["version", "surface", "vectors"],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "conformance-common.schema.json#/$defs/specVersion" },
    "surface": {
      "type": "string",
      "enum": ["neovim-kbd", "emacs-kbd"]
    },
    "source": { "$ref": "conformance-common.schema.json#/$defs/specSource" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "required": ["wire"],
      "additionalProperties": false,
      "properties": {
        "wire": { "type": "string", "minLength": 1 },
        "chords": {
          "type": "array",
          "items": { "$ref": "conformance-common.schema.json#/$defs/quarryChord" }
        },
        "plain": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "anyOf": [
        { "required": ["chords"] },
        { "required": ["plain"] }
      ]
    }
  }
}
