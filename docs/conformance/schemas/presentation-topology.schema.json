{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiders.dev/conformance/schemas/presentation-topology.schema.json",
  "title": "Presentation topology conformance spec",
  "type": "object",
  "required": ["kind", "version", "vectors"],
  "additionalProperties": false,
  "properties": {
    "kind": { "const": "notation.presentation.topology" },
    "version": { "$ref": "conformance-common.schema.json#/$defs/specVersion" },
    "source": { "$ref": "conformance-common.schema.json#/$defs/specSource" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/topologyVector" }
    }
  },
  "$defs": {
    "topologyVector": {
      "type": "object",
      "required": ["id", "wire", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "conformance-common.schema.json#/$defs/vectorId" },
        "wire": { "type": "string", "minLength": 1 },
        "expect": { "$ref": "#/$defs/topologyExpectation" }
      }
    },
    "topologyExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arrangement": {
          "type": "string",
          "enum": ["MultiHost", "SingleSurfaceCompositional", "SingleHostOneOf"]
        },
        "hostCount": { "type": "integer", "minimum": 0 },
        "hosts": {
          "type": "array",
          "items": { "$ref": "#/$defs/topologyHost" }
        }
      }
    },
    "topologyHost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hostIndex": { "type": "integer", "minimum": 0 },
        "hostId": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["Mfd", "Forward", "Pfd", "PmOneOf", "Eicas", "Unknown"]
        },
        "compose": {
          "type": "string",
          "enum": ["Split", "OneOf"]
        },
        "channelStack": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
