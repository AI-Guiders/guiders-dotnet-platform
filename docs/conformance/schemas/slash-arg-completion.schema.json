{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiders.dev/conformance/schemas/slash-arg-completion.schema.json",
  "title": "Slash arg-completion conformance spec",
  "type": "object",
  "required": ["version", "surface", "catalogs", "vectors"],
  "additionalProperties": false,
  "properties": {
    "version": { "$ref": "conformance-common.schema.json#/$defs/specVersion" },
    "surface": { "type": "string", "const": "slash-arg-completion" },
    "source": { "$ref": "conformance-common.schema.json#/$defs/specSource" },
    "catalogs": { "$ref": "conformance-common.schema.json#/$defs/catalogMap" },
    "pickerStubs": { "$ref": "conformance-common.schema.json#/$defs/pickerStubMap" },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "required": ["id", "catalog", "body", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "conformance-common.schema.json#/$defs/vectorId" },
        "catalog": { "type": "string", "minLength": 1 },
        "body": { "type": "string" },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suggestions": { "$ref": "conformance-common.schema.json#/$defs/suggestionsExpectation" },
        "guidance": { "$ref": "conformance-common.schema.json#/$defs/guidanceExpectation" }
      },
      "anyOf": [
        { "required": ["suggestions"] },
        { "required": ["guidance"] }
      ]
    }
  }
}
