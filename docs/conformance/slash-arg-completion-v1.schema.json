{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://guiders.dev/conformance/slash-arg-completion-v1.schema.json",
  "title": "Slash arg-completion conformance spec (v1)",
  "type": "object",
  "required": ["version", "surface", "catalogs", "vectors"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "surface": { "type": "string", "const": "slash-arg-completion" },
    "tier": { "type": "string" },
    "source": { "type": "string" },
    "catalogs": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/catalogEntry" }
      }
    },
    "pickerStubs": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/pickerStub" }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/vector" }
    }
  },
  "$defs": {
    "catalogEntry": {
      "type": "object",
      "required": ["domain", "object", "intent", "commandId", "path"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string" },
        "object": { "type": "string" },
        "intent": { "type": "string" },
        "commandId": { "type": "string" },
        "path": { "type": "string" },
        "pathAliases": { "type": "array", "items": { "type": "string" } },
        "help": { "type": "string" },
        "group": { "type": "string" },
        "argTail": { "type": "string" },
        "argHint": { "type": "string" },
        "argPickerChoices": {
          "type": "array",
          "items": { "$ref": "#/$defs/pickerChoice" }
        }
      }
    },
    "pickerChoice": {
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "label": { "type": "string" },
        "hint": { "type": "string" }
      }
    },
    "pickerStub": {
      "type": "object",
      "required": ["choices"],
      "additionalProperties": false,
      "properties": {
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/pickerChoice" }
        }
      }
    },
    "vector": {
      "type": "object",
      "required": ["id", "catalog", "body", "expect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "catalog": { "type": "string" },
        "body": { "type": "string" },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "suggestions": { "$ref": "#/$defs/suggestionsExpectation" },
        "guidance": { "$ref": "#/$defs/guidanceExpectation" }
      },
      "anyOf": [
        { "required": ["suggestions"] },
        { "required": ["guidance"] }
      ]
    },
    "suggestionsExpectation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/completionItem" }
        },
        "stepSegments": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "completionItem": {
      "type": "object",
      "required": ["kind", "insertText", "slashPath", "help"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["segment", "picker"] },
        "insertText": { "type": "string" },
        "slashPath": { "type": "string" },
        "help": { "type": "string" },
        "group": { "type": ["string", "null"] },
        "stepSegment": { "type": ["string", "null"] },
        "pickValue": { "type": ["string", "null"] }
      }
    },
    "guidanceExpectation": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["Path", "Picker", "FreeText", "Optional", "Ready"] },
        "breadcrumbContains": { "type": "string" },
        "placeholderContains": { "type": "string" },
        "hint": { "type": "string" }
      }
    }
  }
}
