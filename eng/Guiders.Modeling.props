<Project>
  <!-- Sibling monorepo: guiders-fsharp Platform.Modeling.* (ADR-0002 / waves B–D). -->
  <PropertyGroup>
    <GuidersFSharpRoot Condition="'$(GuidersFSharpRoot)' == ''">$(MSBuildThisFileDirectory)..\..\guiders-fsharp</GuidersFSharpRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Condition="'$(UseGuidersModelingCockpitDataBus)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Cockpit.DataBus\AIGuiders.Platform.Modeling.Cockpit.DataBus.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingCockpitCds)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Cockpit.Cds\AIGuiders.Platform.Modeling.Cockpit.Cds.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingCore)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Core\AIGuiders.Platform.Modeling.Core.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingPaths)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Paths\AIGuiders.Platform.Modeling.Paths.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingCatalog)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Catalog\AIGuiders.Platform.Modeling.Catalog.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingRouting)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Routing\AIGuiders.Platform.Modeling.Routing.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNotationsBracket)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Notations.Bracket\AIGuiders.Platform.Modeling.Notations.Bracket.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNotationsKeyboard)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Notations.Keyboard\AIGuiders.Platform.Modeling.Notations.Keyboard.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNotationsCore)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Notations.Core\AIGuiders.Platform.Modeling.Notations.Core.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNotationsArgument)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Notations.Argument\AIGuiders.Platform.Modeling.Notations.Argument.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlExpression)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Expression\AIGuiders.Platform.Modeling.Gdl.Expression.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlParseCockpitLogic)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Parse.CockpitLogic\AIGuiders.Platform.Modeling.Gdl.Parse.CockpitLogic.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingCockpitRules)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Cockpit.Rules\AIGuiders.Platform.Modeling.Cockpit.Rules.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingLanguage)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Language\AIGuiders.Platform.Modeling.Language.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingLanguageAdaptersFcs)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Language.Adapters.Fcs\AIGuiders.Platform.Modeling.Language.Adapters.Fcs.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingLanguageAdaptersGdl)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Language.Adapters.Gdl\AIGuiders.Platform.Modeling.Language.Adapters.Gdl.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingIdeSession)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Ide.Session\AIGuiders.Platform.Modeling.Ide.Session.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingIdeSessionPortsDotNet)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Ide.Session.Ports.DotNet\AIGuiders.Platform.Modeling.Ide.Session.Ports.DotNet.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlCommand)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Command\AIGuiders.Platform.Modeling.Gdl.Command.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlCommandBinding)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Command.Binding\AIGuiders.Platform.Modeling.Gdl.Command.Binding.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlCommandMelody)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Command.Melody\AIGuiders.Platform.Modeling.Gdl.Command.Melody.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlAgent)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Agent\AIGuiders.Platform.Modeling.Gdl.Agent.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlCorrespondence)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Correspondence\AIGuiders.Platform.Modeling.Gdl.Correspondence.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNotationsCommand)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Notations.Command\AIGuiders.Platform.Modeling.Notations.Command.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlLanguage)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Language\AIGuiders.Platform.Modeling.Gdl.Language.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlPresentation)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Presentation\AIGuiders.Platform.Modeling.Gdl.Presentation.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingGdlParseCatalog)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Gdl.Parse.Catalog\AIGuiders.Platform.Modeling.Gdl.Parse.Catalog.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNavigation)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Navigation\AIGuiders.Platform.Modeling.Navigation.fsproj" />
    <ProjectReference Condition="'$(UseGuidersModelingNavigationPolicy)' == 'true'"
      Include="$(GuidersFSharpRoot)\src\AIGuiders.Platform.Modeling.Navigation.Policy\AIGuiders.Platform.Modeling.Navigation.Policy.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- FSharp.Core обязателен явно: CPM в sibling guiders-fsharp вычищает транзитивный
         FSharp.Core из restore-графа → CS0012 FSharpMap/FSharpOption/FSharpList (Тихон 2026-09-08). -->
    <PackageReference Include="FSharp.Core" Version="10.1.400" />
  </ItemGroup>
</Project>
