<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>AIGuiders.Platform.Conformance.Schemas</RootNamespace>
    <AssemblyName>AIGuiders.Platform.Conformance.Schemas</AssemblyName>
    <PackageId>AIGuiders.Platform.Conformance.Schemas</PackageId>
    <Description>JSON Schema registry + validator for federation conformance specs.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="7.4.0" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\conformance\schemas\*.schema.json" Link="schemas\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
