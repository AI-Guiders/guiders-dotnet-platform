catalog test

channels
  slash
    bar = toolbar-slash
    command-notation = command-slash
    argument-notation = argument-slash
  palette = command-palette
end channels

defaults
  notation.keyboard.binding = keyboard-vim
  binding.chord-root        = Ctrl+K
end defaults

bindings table
  | gesture      | command | role       |
  | Ctrl+Shift+D | filter  | execute    |
end bindings
