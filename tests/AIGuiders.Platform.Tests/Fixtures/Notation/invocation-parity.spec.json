{
  "version": 1,
  "surface": "invocation-parity",
  "source": "GUIDERS-ADR-0021 slash vs console path + kv parity",
  "vectors": [
    {
      "id": "buffer-open",
      "slashLine": "/buffer open",
      "consoleLine": "buffer open",
      "expect": {
        "canonicalPath": "buffer open"
      }
    },
    {
      "id": "scene-focus",
      "slashLine": "/scene focus",
      "consoleLine": "scene focus",
      "expect": {
        "canonicalPath": "scene focus"
      }
    },
    {
      "id": "forge-repo-create",
      "slashLine": "/forge repo create",
      "consoleLine": "forge repo create",
      "expect": {
        "canonicalPath": "forge repo create"
      }
    },
    {
      "id": "buffer-open-doc-kv",
      "slashLine": "/buffer open",
      "consoleLine": "buffer open doc=README.md",
      "expect": {
        "canonicalPath": "buffer open",
        "slots": { "doc": "README.md" }
      }
    },
    {
      "id": "scene-focus-op-kv",
      "slashLine": "/scene focus",
      "consoleLine": "scene focus op=build config=release",
      "expect": {
        "canonicalPath": "scene focus",
        "slots": { "op": "build", "config": "release" }
      }
    }
  ]
}
